    "prisma:migrate:status": "prisma migrate status",
    "permissions:sync": "node ./scripts/syncPermissions.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.3.1",
    "express": "~4.16.1",
    "express-async-handler": "^1.2.0",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "~1.9.1",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^7.9.0"
  }
}
