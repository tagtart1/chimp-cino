{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "nodemon ./bin/www",
    "prestart": "prisma generate && pnpm run permissions:sync",
    "start": "node ./bin/www",
    "test": "node --test",
    "prisma:generate": "prisma generate",
