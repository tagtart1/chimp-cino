generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum GameType {
  BLACKJACK
  MINES
  ROULETTE
}

model User {
  id                      Int       @id @default(autoincrement())
  username                String    @db.VarChar(50)
  email                   String    @unique @db.VarChar(255)
  password                String
  balance                 Decimal   @default(10000.00) @db.Decimal(14, 2)
  dailyBonusStreak        Int       @default(0)
  lastDailyBonusClaimedOn DateTime? @db.Date

  blackjackGame ActiveBlackjackGame?
  minesGame     ActiveMinesGame?
  gameResults   GameResult[]
  roles         Role[]
}

model Role {
  id          Int    @id @default(autoincrement())
  key         String @unique @db.VarChar(100)
  displayName String @db.VarChar(100)

  users       User[]
  permissions Permission[]
}

model Permission {
  id          Int    @id @default(autoincrement())
  key         String @unique @db.VarChar(100)
  displayName String @db.VarChar(100)

  roles Role[]
}

model Card {
  id    Int    @id
  rank  String @db.VarChar(2)
  suit  String @db.Char(1)
  value Int

  activeHandCards ActiveHandCard[]

  @@unique([rank, suit])
}

model ActiveBlackjackGame {
  id             Int     @id @default(autoincrement())
  isGameOver     Boolean @default(false)
  userId         Int     @unique
  startBet       Decimal @db.Decimal(14, 2)
  totalWagered   Decimal @db.Decimal(14, 2)
  offerInsurance Boolean @default(false)

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hands ActiveHand[]
}

model ActiveHand {
  id          Int     @id @default(autoincrement())
  gameId      Int
  isPlayer    Boolean
  isSelected  Boolean @default(true)
  isCompleted Boolean @default(false)
  isBust      Boolean @default(false)
  bet         Decimal @default(0.00) @db.Decimal(14, 2)

  game  ActiveBlackjackGame @relation(fields: [gameId], references: [id], onDelete: Cascade)
  cards ActiveHandCard[]

  @@index([gameId])
}

model ActiveHandCard {
  handId   Int
  cardId   Int
  sequence Int

  hand ActiveHand @relation(fields: [handId], references: [id], onDelete: Cascade)
  card Card       @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@id([handId, sequence])
  @@index([cardId])
}

model ActiveMinesGame {
  id         Int     @id @default(autoincrement())
  userId     Int     @unique
  bet        Decimal @db.Decimal(14, 2)
  multiplier Decimal @default(1.000000) @db.Decimal(20, 6)

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cells ActiveCell[]
}

model ActiveCell {
  gameId     Int
  field      Int
  isGem      Boolean
  isRevealed Boolean @default(false)

  game ActiveMinesGame @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([gameId, field])
}

model GameResult {
  id          BigInt   @id @default(autoincrement())
  userId      Int
  gameType    GameType
  wagered     Decimal  @db.Decimal(14, 2)
  payout      Decimal  @db.Decimal(14, 2)
  completedAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt, id])
  @@index([userId, gameType, completedAt, id])
}
